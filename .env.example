# ============================================================
# 环境变量模板 —— 复制成 .env 后填自己的真实值
#   用法：cp .env.example .env   （.env 已被 .gitignore 忽略，不会上传）
#   注意：本文件里只放占位符，绝不放真实密钥。真实值只存在于 .env
#         和 CloudBase 云函数的环境变量里（cloudbaserc.json 部署后立即还原）。
# ============================================================

# CloudBase 环境 ID（非密钥，可公开；与 cloudbaserc.json 的 envId 一致）
TCB_ENV_ID=rqj-2006-d0gl1ael531a243a1

# CloudBase 数据库 API Key（真实密钥，形如 eyJ... 的 JWT）
# 用途：云函数调 exec-pgsql 网关 / db/exec.py 执行 SQL
# 获取：腾讯云 CloudBase 控制台 → 环境 → 数据库 → API Key
# 注入：只写进云函数环境变量 CB_API_KEY，不要写进任何入库文件
CB_API_KEY=<在此填入你的 API Key，不要提交这个文件>

# 本地 SQL 执行脚本用（db/exec.py 读取；留空则用 tcb CLI 通道）
DATABASE_URL=<postgresql://user:password@host:5432/dbname>
DATABASE_PASSWORD=<数据库密码>

# tcb CLI 路径（可选；不填则 db/exec.py 自动探测）
TCB_CLI=
